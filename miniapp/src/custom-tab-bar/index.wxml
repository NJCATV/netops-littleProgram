<view class="tab-shell">
  <view class="tab-bar">
    <view wx:for="{{tabs}}" wx:key="pagePath" class="tab-item {{item.type === 'ai' ? 'tab-ai' : ''}} {{selected === index ? 'active' : ''}}" hover-class="tab-pressed" hover-stay-time="90" data-index="{{index}}" bindtap="switchTab">
      <block wx:if="{{item.type === 'menu'}}">
        <view class="menu-icon"><view class="menu-dot"></view><view class="menu-dot"></view><view class="menu-dot"></view><view class="menu-dot"></view></view>
      </block>
      <block wx:elif="{{item.type === 'profile'}}">
        <view class="profile-icon"><view class="profile-head-icon"></view><view class="profile-body-icon"></view></view>
      </block>
      <block wx:else>
        <view class="ai-halo"></view>
        <view class="ai-button"><view class="ai-spark">✦</view><view class="ai-bubble">AI</view></view>
      </block>
      <text class="tab-label">{{item.text}}</text>
    </view>
  </view>
</view>
