page {
  min-height: 100%;
  --td-brand-color: #2f5f8f;
  --td-brand-color-active: #244b72;
  --td-brand-color-disabled: #a7b8ca;
  --td-brand-color-light: #e8eef4;
  --td-radius-default: 4rpx;
  --td-button-border-radius: 4rpx;
  --td-button-font-weight: 500;
  background: #f4f6f8;
  color: #202832;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 28rpx;
}

view,
text,
button,
input,
picker,
scroll-view,
textarea {
  box-sizing: border-box;
  max-width: 100%;
}

button {
  width: auto;
  min-width: 0;
  margin: 0;
  padding: 0;
  border-radius: 4rpx;
  font-size: 28rpx;
  line-height: 1.4;
}

button::after {
  border: 0;
}

.page {
  width: 100%;
  max-width: 100vw;
  min-height: 100vh;
  padding: 32rpx;
  overflow-x: hidden;
}

.section {
  margin-top: 24rpx;
}

.panel {
  border: 1rpx solid #d9e0e7;
  border-radius: 4rpx;
  background: #ffffff;
}

.hairline-top {
  border-top: 1rpx solid #d9e0e7;
}

.hairline-bottom {
  border-bottom: 1rpx solid #d9e0e7;
}

.status-text {
  color: #4e5c6b;
  font-size: 24rpx;
  line-height: 1.6;
}

.muted {
  color: #6f7d8c;
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-width: 0;
  min-height: 88rpx;
  padding: 0 28rpx;
  background: #2f5f8f;
  color: #ffffff;
}

.secondary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-width: 0;
  min-height: 80rpx;
  padding: 0 24rpx;
  border: 1rpx solid #b8c4d0;
  background: #ffffff;
  color: #2f3b4a;
}
