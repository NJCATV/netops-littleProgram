.orgs-page {
  padding-bottom: 48rpx;
}

.top-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 34rpx 28rpx;
  border-radius: 8rpx;
  background: linear-gradient(135deg, #2f7df6 0%, #1f64da 100%);
  color: #ffffff;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
}

.page-subtitle {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.8);
  font-size: 24rpx;
}

.icon-button {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  color: #ffffff;
  font-size: 42rpx;
}

.org-list {
  margin-top: 24rpx;
  overflow: hidden;
  border-radius: 8rpx;
}

.org-row {
  display: flex;
  align-items: center;
  min-height: 92rpx;
  padding: 0 18rpx;
  border-bottom: 1rpx solid #edf1f5;
  background: #ffffff;
}

.level-2 {
  padding-left: 44rpx;
}

.level-3 {
  padding-left: 72rpx;
}

.org-main {
  flex: 1;
  min-width: 0;
}

.org-name {
  overflow: hidden;
  color: #202832;
  font-size: 28rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.org-meta {
  margin-top: 6rpx;
  color: #7d8ca0;
  font-size: 22rpx;
}

.text-button {
  width: 74rpx;
  height: 54rpx;
  background: transparent;
  color: #2f7df6;
  font-size: 23rpx;
}

.text-button.danger {
  color: #d92d20;
}

.form-mask {
  position: fixed;
  inset: 0;
  z-index: 10;
  display: flex;
  align-items: flex-end;
  background: rgba(32, 40, 50, 0.36);
}

.form-panel {
  width: 100%;
  max-height: 86vh;
  padding: 30rpx 32rpx 44rpx;
  overflow-y: auto;
  border-radius: 16rpx 16rpx 0 0;
  background: #ffffff;
}

.form-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.form-title {
  font-size: 34rpx;
  font-weight: 700;
}

.close-button {
  width: 64rpx;
  height: 64rpx;
  background: #f4f6f8;
  color: #6f7d8c;
  font-size: 38rpx;
}

.field-group + .field-group {
  margin-top: 22rpx;
}

.field-label {
  margin-bottom: 12rpx;
  color: #202832;
  font-size: 26rpx;
  font-weight: 600;
}

.form-input,
.picker-value {
  min-height: 80rpx;
  padding: 0 22rpx;
  border: 1rpx solid #d9e0e7;
  border-radius: 4rpx;
  background: #f9fafb;
  color: #202832;
  font-size: 26rpx;
  line-height: 80rpx;
}

.save-button {
  margin-top: 30rpx;
}
