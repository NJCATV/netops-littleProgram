.users-page {
  padding-bottom: 48rpx;
}

.top-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 34rpx 28rpx;
  border-radius: 4rpx;
  background: linear-gradient(135deg, #2f7df6 0%, #1f5fc7 100%);
  color: #ffffff;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
}

.page-subtitle {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.8);
  font-size: 24rpx;
}

.icon-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.18);
  color: #ffffff;
  font-size: 42rpx;
}

.search-row {
  display: flex;
  gap: 16rpx;
  margin: 24rpx 0;
}

.search-input {
  flex: 1;
  height: 76rpx;
  padding: 0 22rpx;
  border: 1rpx solid #d9e0e7;
  border-radius: 4rpx;
  background: #ffffff;
  color: #202832;
  font-size: 26rpx;
}

.search-button {
  width: 128rpx;
  height: 76rpx;
  background: #2f7df6;
  color: #ffffff;
  font-size: 26rpx;
}

.filter-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
  margin: 0 0 24rpx;
}

.filter-pill {
  height: 68rpx;
  padding: 0 18rpx;
  overflow: hidden;
  border: 1rpx solid #d9e0e7;
  border-radius: 4rpx;
  background: #ffffff;
  color: #4e5c6b;
  font-size: 24rpx;
  line-height: 68rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.input-placeholder {
  color: #a4aeb8;
}

.user-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.user-card {
  padding: 24rpx;
}

.user-name {
  color: #202832;
  font-size: 32rpx;
  font-weight: 700;
}

.user-meta {
  margin-top: 8rpx;
  color: #6f7d8c;
  font-size: 24rpx;
  line-height: 1.5;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.tag {
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  background: #e8eef4;
  color: #2f5f8f;
  font-size: 22rpx;
}

.action-row {
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
  margin-top: 18rpx;
}

.text-button {
  min-width: 104rpx;
  height: 58rpx;
  border: 1rpx solid #d9e0e7;
  background: #ffffff;
  color: #2f5f8f;
  font-size: 24rpx;
}

.form-mask {
  position: fixed;
  inset: 0;
  z-index: 10;
  display: flex;
  align-items: flex-end;
  background: rgba(32, 40, 50, 0.36);
}

.form-panel {
  width: 100%;
  max-height: 86vh;
  padding: 30rpx 32rpx 44rpx;
  overflow-y: auto;
  border-radius: 16rpx 16rpx 0 0;
  background: #ffffff;
}

.form-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.form-title {
  color: #202832;
  font-size: 34rpx;
  font-weight: 700;
}

.close-button {
  width: 64rpx;
  height: 64rpx;
  background: #f4f6f8;
  color: #6f7d8c;
  font-size: 38rpx;
}

.field-group + .field-group {
  margin-top: 22rpx;
}

.field-label {
  margin-bottom: 12rpx;
  color: #202832;
  font-size: 26rpx;
  font-weight: 600;
}

.form-input,
.picker-value {
  min-height: 80rpx;
  padding: 0 22rpx;
  border: 1rpx solid #d9e0e7;
  border-radius: 4rpx;
  background: #f9fafb;
  color: #202832;
  font-size: 26rpx;
  line-height: 80rpx;
}

.save-button {
  margin-top: 30rpx;
}
