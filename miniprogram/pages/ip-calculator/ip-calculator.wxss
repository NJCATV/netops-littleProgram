.ip-page {
  background: #f3f5f7;
}

.page-header {
  padding: 10rpx 0 22rpx;
}

.page-title {
  color: #202832;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.35;
}

.page-subtitle {
  margin-top: 10rpx;
  color: #5f6d7a;
  font-size: 24rpx;
  line-height: 1.5;
}

.tab-strip {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  border: 1rpx solid #cfd6de;
  background: #ffffff;
}

.tab-item {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 76rpx;
  padding: 0 8rpx;
  border-right: 1rpx solid #d7dde3;
  color: #4e5c6b;
  font-size: 23rpx;
  text-align: center;
}

.tab-item:last-child {
  border-right: 0;
}

.tab-item.active {
  background: #e8eef4;
  color: #1f6f9f;
  font-weight: 600;
}

.tab-content {
  margin-top: 22rpx;
}

.form-panel,
.result-panel {
  margin-top: 18rpx;
  padding: 24rpx;
  border-color: #d7dde3;
}

.tab-content > .form-panel:first-child {
  margin-top: 0;
}

.block-title {
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #edf1f5;
  color: #202832;
  font-size: 28rpx;
  font-weight: 600;
}

.form-item {
  margin-top: 20rpx;
}

.field-label {
  color: #2f3b4a;
  font-size: 24rpx;
  font-weight: 500;
}

.field-input {
  min-height: 78rpx;
  margin-top: 10rpx;
  padding: 0 18rpx;
  border: 1rpx solid #cfd6de;
  background: #f9fafb;
  color: #202832;
  font-size: 26rpx;
}

.button-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 18rpx;
  margin-top: 24rpx;
}

.calc-button {
  width: 100%;
  min-width: 0;
  min-height: 78rpx;
  font-size: 28rpx;
}

.error-text {
  margin-top: 16rpx;
  color: #9a2f2f;
  font-size: 24rpx;
  line-height: 1.5;
}

.empty-result {
  padding: 34rpx 0 12rpx;
  color: #7a8794;
  font-size: 25rpx;
  line-height: 1.5;
}

.inline-empty {
  padding-bottom: 0;
}

.result-list {
  margin-top: 8rpx;
}

.compact-list {
  margin-top: 18rpx;
}

.result-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #edf1f5;
}

.result-row:last-child {
  border-bottom: 0;
}

.result-main {
  min-width: 0;
  flex: 1;
}

.result-label {
  color: #6f7d8c;
  font-size: 22rpx;
  line-height: 1.4;
}

.result-value {
  margin-top: 6rpx;
  color: #202832;
  font-size: 26rpx;
  line-height: 1.45;
  word-break: break-all;
}

.result-value.emphasis {
  color: #1d6f9f;
  font-weight: 700;
}

.copy-button {
  display: flex;
  align-items: center;
  justify-content: center;
  align-self: flex-start;
  flex: 0 0 auto;
  min-width: 92rpx;
  height: 54rpx;
  margin-top: 36rpx;
  padding: 0 20rpx;
  border: 1rpx solid #cfd6de;
  background: #ffffff;
  color: #1f6f9f;
  font-size: 23rpx;
  line-height: 54rpx;
}
