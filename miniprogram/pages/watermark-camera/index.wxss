.camera-page {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  width: 100%;
  max-width: 100vw;
  height: 100%;
  overflow: hidden;
  background: #f4f6f8;
}

.camera-page view,
.camera-page button,
.camera-page input,
.camera-page picker,
.camera-page scroll-view {
  box-sizing: border-box;
}

.camera-stage {
  position: relative;
  overflow: hidden;
  width: 100%;
  max-width: 100vw;
  flex: 1;
  min-height: 0;
  background: #111820;
}

.camera-frame {
  display: block;
  width: 100%;
  height: 100%;
}

.camera-tools {
  position: absolute;
  top: 28rpx;
  right: 24rpx;
  z-index: 3;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.camera-tool {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.48);
  background: rgba(18, 28, 38, 0.45);
  color: #ffffff;
}

.camera-tool.active {
  border-color: rgba(255, 212, 0, 0.78);
  background: rgba(47, 95, 143, 0.72);
}

.tool-symbol {
  font-size: 34rpx;
  line-height: 1;
}

.tool-label {
  margin-top: 8rpx;
  font-size: 20rpx;
  line-height: 1;
}

.watermark-preview {
  position: absolute;
  z-index: 2;
  left: 28rpx;
  bottom: 28rpx;
  max-width: 650rpx;
  padding: 18rpx 22rpx;
  background: rgba(12, 18, 24, 0.68);
  color: #ffffff;
}

.watermark-panel-style {
  right: 28rpx;
  border-left: 8rpx solid #ffd400;
}

.watermark-simple-style {
  left: 28rpx;
  right: auto;
  top: 28rpx;
  bottom: auto;
  max-width: 600rpx;
  padding: 0;
  background: transparent;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.72);
}

.watermark-bar-style {
  left: 0;
  right: 0;
  bottom: 0;
  max-width: none;
  border-left: 0;
  background: rgba(12, 18, 24, 0.76);
}

.watermark-stamp-style {
  left: auto;
  right: 28rpx;
  top: 360rpx;
  bottom: auto;
  max-width: 430rpx;
  border-top: 8rpx solid #2f8cc8;
  background: rgba(246, 248, 250, 0.82);
}

.watermark-stamp-style .preview-line {
  color: #202832;
  font-size: 24rpx;
}

.watermark-bar-style .preview-line {
  display: inline;
  margin-right: 22rpx;
  font-size: 24rpx;
}

.preview-line {
  color: #ffffff;
  font-size: 28rpx;
  line-height: 1.45;
  word-break: break-all;
}

.camera-error {
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  top: 28rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid #d59b9b;
  background: #fff2f2;
  color: #9a2f2f;
  font-size: 24rpx;
  line-height: 1.5;
}

.bottom-panel {
  position: relative;
  flex: 0 0 auto;
  width: 100%;
  max-width: 100vw;
  padding: 16rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  overflow: hidden;
  background: #ffffff;
  box-shadow: 0 -8rpx 22rpx rgba(24, 36, 48, 0.08);
}

.status-line {
  min-height: 30rpx;
  color: #6f7d8c;
  font-size: 22rpx;
  line-height: 1.35;
}

.main-actions {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 20rpx;
  margin-top: 14rpx;
}

.action-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-width: 0;
  min-height: 78rpx;
  margin: 0;
  padding: 0;
  border-radius: 4rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.2;
}

.primary-action {
  background: #2f5f8f;
  color: #ffffff;
}

.secondary-action {
  border: 1rpx solid #b8c4d0;
  background: #ffffff;
  color: #202832;
}

.settings-strip {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.setting-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 60rpx;
  border: 1rpx solid #d9e0e7;
  background: #f7f9fb;
  color: #2f3b4a;
  font-size: 23rpx;
  white-space: nowrap;
}

.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  background: rgba(18, 28, 38, 0.42);
}

.bottom-sheet {
  width: 100%;
  border-top: 1rpx solid #cfd6de;
  background: #ffffff;
}

.date-sheet {
  padding: 24rpx 28rpx 34rpx;
}

.more-sheet {
  height: 70vh;
  padding: 0 28rpx 28rpx;
}

.sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 86rpx;
  border-bottom: 1rpx solid #edf1f5;
}

.sheet-title {
  color: #202832;
  font-size: 30rpx;
  font-weight: 600;
}

.sheet-close {
  color: #2f5f8f;
  font-size: 26rpx;
}

.datetime-sheet-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 14rpx;
  margin-top: 22rpx;
}

.datetime-cell {
  min-height: 82rpx;
  padding: 12rpx 16rpx;
  border: 1rpx solid #d9e0e7;
  background: #f7f9fb;
}

.datetime-label {
  display: block;
  color: #6f7d8c;
  font-size: 22rpx;
  line-height: 1.3;
}

.datetime-value {
  display: block;
  margin-top: 4rpx;
  color: #202832;
  font-size: 26rpx;
  line-height: 1.3;
}

.sheet-actions {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 18rpx;
  margin-top: 26rpx;
}

.sheet-button {
  min-height: 78rpx;
}

.more-scroll {
  height: calc(70vh - 116rpx);
}

.setting-block {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #edf1f5;
}

.setting-block:last-child {
  border-bottom: 0;
}

.setting-title {
  color: #202832;
  font-size: 28rpx;
  font-weight: 600;
}

.style-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin-top: 16rpx;
}

.style-item {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 64rpx;
  border: 1rpx solid #c8d2dc;
  background: #ffffff;
  color: #4e5c6b;
  font-size: 24rpx;
}

.style-item.active {
  border-color: #2f5f8f;
  background: #e8eef4;
  color: #2f5f8f;
  font-weight: 600;
}

.field-list {
  margin-top: 6rpx;
}

.watermark-field {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #edf1f5;
}

.watermark-field:last-child {
  border-bottom: 0;
}

.field-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.field-name {
  color: #202832;
  font-size: 26rpx;
  font-weight: 500;
}

.field-switch {
  transform: scale(0.78);
  transform-origin: right center;
}

.field-input,
.field-static {
  width: 100%;
  min-height: 70rpx;
  margin-top: 10rpx;
  padding: 0 18rpx;
  border: 1rpx solid #d9e0e7;
  background: #f9fafb;
  color: #202832;
  font-size: 26rpx;
}

.field-static {
  display: flex;
  align-items: center;
}

.field-action {
  color: #2f5f8f;
}

.picker-select {
  color: #2f5f8f;
}

.admin-exit {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 76rpx;
  margin-top: 20rpx;
  border: 1rpx solid #c8d2dc;
  background: #ffffff;
  color: #4e5c6b;
  font-size: 26rpx;
}

.pin-dialog {
  width: calc(100% - 96rpx);
  max-width: 620rpx;
  margin: auto;
  padding: 34rpx 32rpx 30rpx;
  border: 1rpx solid #d9e0e7;
  background: #ffffff;
}

.pin-title {
  color: #202832;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
}

.pin-input {
  min-height: 78rpx;
  margin-top: 28rpx;
  border: 1rpx solid #c8d2dc;
  background: #f7f9fb;
  color: #202832;
  font-size: 34rpx;
  text-align: center;
}

.pin-actions {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 18rpx;
  margin-top: 28rpx;
}

.pin-button {
  width: 100%;
  min-width: 0;
  min-height: 76rpx;
  padding: 0 16rpx;
}

.canvas-holder {
  position: fixed;
  left: -20000px;
  top: -20000px;
  width: 2000px;
  height: 2000px;
  overflow: visible;
  opacity: 0;
  pointer-events: none;
}
