.workbench-page {
  min-height: 100vh;
  padding: 0 24rpx 132rpx;
  background: #f4f7fb;
}

.hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 -24rpx;
  padding: 76rpx 36rpx 34rpx;
  background: linear-gradient(135deg, #2f7df6 0%, #1f64da 100%);
  color: #ffffff;
}

.hero-main {
  display: flex;
  align-items: center;
  gap: 22rpx;
  min-width: 0;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 78rpx;
  height: 78rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  border-radius: 50%;
  background: #ffffff;
  color: #1f64da;
  font-size: 32rpx;
  font-weight: 700;
}

.hero-name {
  max-width: 520rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 32rpx;
  font-weight: 700;
}

.hero-org {
  font-size: 26rpx;
  font-weight: 400;
}

.hero-subtitle {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 23rpx;
}

.notice-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 72rpx;
  margin-top: 22rpx;
  padding: 0 20rpx;
  border-radius: 8rpx;
  background: #eef5ff;
}

.notice-text {
  flex: 1;
  color: #4e5c6b;
  font-size: 24rpx;
}

.app-section {
  margin-top: 22rpx;
  padding: 24rpx 20rpx;
  border-radius: 8rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.section-title {
  color: #101828;
  font-size: 30rpx;
  font-weight: 700;
}

.section-action {
  display: flex;
  align-items: center;
  gap: 6rpx;
  color: #2f7df6;
  font-size: 24rpx;
}

.app-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  row-gap: 30rpx;
}

.app-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.app-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 78rpx;
  height: 78rpx;
  border-radius: 12rpx;
}

.color-0 { background: #2f7df6; }
.color-1 { background: #19b968; }
.color-2 { background: #7a5cf0; }
.color-3 { background: #f37b16; }
.color-4 { background: #13bfc0; }
.color-5 { background: #5a6b7f; }

.app-name {
  width: 100%;
  overflow: hidden;
  color: #202832;
  font-size: 24rpx;
  line-height: 1.3;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bottom-nav {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  height: 112rpx;
  border-top: 1rpx solid #dde5ef;
  background: #ffffff;
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  color: #7d8ca0;
  font-size: 22rpx;
}

.nav-item.active {
  color: #2f7df6;
}
